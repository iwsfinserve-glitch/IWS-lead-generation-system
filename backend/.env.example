# ═══════════════════════════════════════════════════════
# Lead Management CRM — Backend Environment Variables
# ═══════════════════════════════════════════════════════

# ── Environment & Production Flags ──
PRODUCTION=False
ENVIRONMENT=development
SENTRY_DSN=

# ── CORS Configuration ──
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8501,http://localhost:8000

# ── PostgreSQL (Async Driver) ──
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lead_crm

# ── JWT Authentication ──
SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ── SEO Public Intake API ──
SEO_WEB_API_KEY=your-seo-web-api-key

# ── RERA Scraper API ──
RERA_SCRAPER_API_KEY=your-rera-scraper-api-key

# ── Google OAuth 2.0 (Workspace Sync) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173

# ── Fernet Encryption Key (for Google tokens at rest) ──
ENCRYPTION_KEY=

# ── Gemini AI ──
GEMINI_API_KEY=

# ── Evolution API (WhatsApp Gateway) ──
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
